عام السرعة = 280
عام قوة_القفز = 560
عرف الاتجاه = 0
إذا زر_مستمر("حركة_يمين")
    الاتجاه = 1
نهاية
إذا زر_مستمر("حركة_يسار")
    الاتجاه = -1
نهاية
سرعة("الكتلة", الاتجاه * السرعة)
إذا زر_مضغوط("قفز") و على_الأرض("الكتلة")
    اقفز("الكتلة", قوة_القفز)
نهاية
إذا موضع_س("الكتلة") < 0
    ضع_موضع("الكتلة", 0, موضع_ص("الكتلة"))
نهاية
إذا موضع_س("الكتلة") + عرض("الكتلة") > عرض_العالم()
    ضع_موضع("الكتلة", عرض_العالم() - عرض("الكتلة"), موضع_ص("الكتلة"))
نهاية
